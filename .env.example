# ==============================================================================
# Coy — Environment Variables Configuration
# ==============================================================================

# Database Connection (Used for local Prisma SQLite or external PostgreSQL/MySQL)
# On Vercel, the application automatically uses the zero-config static data engine.
DATABASE_URL="file:./dev.db"

# Enable demo deck reset (/api/reset) for interviewers and reviewers
# Default: true (automatically enabled on Vercel and during development)
ENABLE_DEMO_RESET="true"

# Force Static Data Mode locally (optional; automatically enabled on Vercel)
# USE_STATIC_DATA="true"
